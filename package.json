{
  "name": "meiji-rat-pet",
  "version": "0.2.0",
  "private": true,
  "description": "美叽与大鼠 · 桌面宠物",
  "author": "PeculiarJustin",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "python -m http.server 5173",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.peculiarjustin.meiji-rat",
    "productName": "MeijiRatPet",
    "asar": true,
    "files": [
      "index.html",
      "style.css",
      "pet.js",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "美叽与大鼠"
    },
    "artifactName": "MeijiRatPet-Setup-${version}.${ext}"
  }
}
